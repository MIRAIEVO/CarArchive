<Page x:Class="CarArchive.MainPage"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:core="using:CarArchive.Core"
 AllowDrop="True" DragOver="Page_DragOver" Drop="Page_Drop" Loaded="Page_Loaded">
 <Page.Resources>
  <ResourceDictionary>
   <Style x:Key="QuietButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
    <Setter Property="BorderThickness" Value="0"/><Setter Property="Background" Value="Transparent"/>
    <Setter Property="Padding" Value="10,6"/>
   </Style>
  </ResourceDictionary>
 </Page.Resources>
 <Grid Padding="12,0,12,10" RowSpacing="6">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <CommandBar DefaultLabelPosition="Right" Background="Transparent" ClosedDisplayMode="Compact">
   <CommandBar.Content>
    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
     <DropDownButton x:Name="ModeButton" BorderThickness="0" Background="Transparent" ToolTipService.ToolTip="选择联网识别模式">
      <TextBlock x:Name="ModeLabel" Text="精简字段"/>
      <DropDownButton.Flyout><Flyout x:Name="ModeFlyout" Opening="ModeFlyout_Opening"><StackPanel Width="280" Spacing="10">
       <TextBlock x:Name="ModePopupTitle" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center"/>
       <TextBlock x:Name="ModeModelText" FontSize="12" HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
       <Slider x:Name="ModeSlider" Minimum="0" Maximum="3" StepFrequency="1" TickFrequency="1" TickPlacement="BottomRight" SnapsTo="StepValues" IsThumbToolTipEnabled="False" ValueChanged="ModeSlider_Changed" AutomationProperties.Name="识别模式"/>
       <TextBlock x:Name="ModeDescription" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
       <HyperlinkButton Content="模型与检索设置" Click="ModeSettings_Click" HorizontalAlignment="Center"/>
      </StackPanel></Flyout></DropDownButton.Flyout>
     </DropDownButton>
     <ComboBox x:Name="PaneBox" Width="80" SelectedIndex="1" Visibility="Collapsed" SelectionChanged="Pane_Changed"><ComboBoxItem Content="分组"/><ComboBoxItem Content="照片"/><ComboBoxItem Content="复核"/></ComboBox>
    </StackPanel>
   </CommandBar.Content>
   <AppBarButton Icon="Add" Label="导入一组" Click="ImportGroup_Click"/>
   <AppBarButton Icon="OpenFile" Label="批量导入" Click="ImportBatch_Click"/>
   <CommandBar.SecondaryCommands>
    <AppBarButton Icon="Setting" Label="设置" Click="Settings_Click"/>
    <AppBarButton Icon="Edit" Label="命名学习" Click="Rules_Click"/>
    <AppBarButton Icon="Clock" Label="操作记录与恢复" Click="History_Click"/>
    <AppBarButton Icon="Undo" Label="撤销最近归档" Click="Undo_Click"/>
   </CommandBar.SecondaryCommands>
  </CommandBar>
  <Grid Grid.Row="1" ColumnSpacing="8">
   <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <TextBlock Text="{x:Bind VM.Summary,Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
   <TextBlock Grid.Column="1" Text="{x:Bind VM.Status,Mode=OneWay}" FontSize="11" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
   <InfoBar x:Name="Notice" IsOpen="False" Visibility="Collapsed"/>
  </Grid>
  <Grid x:Name="BodyGrid" Grid.Row="2" ColumnSpacing="12" SizeChanged="Body_SizeChanged">
   <Grid.ColumnDefinitions><ColumnDefinition x:Name="QueueColumn" Width="210"/><ColumnDefinition Width="*"/><ColumnDefinition x:Name="EditorColumn" Width="350"/></Grid.ColumnDefinitions>
   <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition x:Name="NarrowRow" Height="0"/></Grid.RowDefinitions>
   <Grid x:Name="QueuePane" RowSpacing="6">
    <Grid.RowDefinitions><RowDefinition Height="*"/></Grid.RowDefinitions>
    <ListView x:Name="GroupList" ContextRequested="Group_ContextRequested" ItemsSource="{x:Bind VM.Groups}" SelectionMode="Extended" SelectionChanged="Group_Changed" Padding="0">
     <ListView.Resources><SolidColorBrush x:Key="ListViewItemSelectionIndicatorBrush" Color="Transparent"/><SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="{ThemeResource SystemAccentColor}" Opacity="0.20"/><SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="{ThemeResource SystemAccentColor}" Opacity="0.28"/><SolidColorBrush x:Key="ListViewItemBackgroundSelectedUnfocused" Color="{ThemeResource SystemAccentColor}" Opacity="0.18"/></ListView.Resources>
     <ListView.ContextFlyout><MenuFlyout><MenuFlyoutItem x:Name="MergeGroupsMenu" Text="合并选中分组" Click="Merge_Click"/><MenuFlyoutItem x:Name="DuplicateGroupMenu" Text="复制分组" Click="Duplicate_Click"/><MenuFlyoutSeparator/><MenuFlyoutItem x:Name="DeleteGroupsMenu" Text="删除选中分组（保留源照片）" Click="DeleteImportedGroup_Click"/><MenuFlyoutItem x:Name="DeleteArchivedMenu" Text="删除所有已归档分组" Click="DeleteAllArchivedGroups_Click"/></MenuFlyout></ListView.ContextFlyout>
     <ListView.ItemTemplate><DataTemplate x:DataType="core:PhotoGroup">
      <Grid Padding="0,5" ColumnSpacing="7" Opacity="{x:Bind DisplayOpacity,Mode=OneWay}">
       <Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/></Grid.ColumnDefinitions>
       <Image Source="{Binding CoverUri,Converter={StaticResource SafeImageSourceConverter}}" Width="48" Height="48" Stretch="UniformToFill"/>
       <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center"><Grid><TextBlock Text="{x:Bind Title,Mode=OneWay}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" FontSize="12"/><Border Height="1" VerticalAlignment="Center" Background="{ThemeResource TextFillColorPrimaryBrush}" Opacity="{x:Bind ArchivedStrikeOpacity,Mode=OneWay}"/></Grid><TextBlock Text="{x:Bind Subtitle,Mode=OneWay}" FontSize="10" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind TaskLabel,Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel>
       <Ellipse Grid.Column="2" Width="8" Height="8" Fill="{Binding TaskColor}" ToolTipService.ToolTip="{x:Bind TaskLabel,Mode=OneWay}"/>
      </Grid>
     </DataTemplate></ListView.ItemTemplate>
    </ListView>
   </Grid>
   <Grid x:Name="PreviewPane" Grid.Column="1" RowSpacing="6">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition x:Name="ThumbnailRow" Height="146"/></Grid.RowDefinitions>
    <TextBlock x:Name="PhotoCaption" Text="点击缩略图即设为代表图" FontSize="12" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
    <Border Grid.Row="1" Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="6" MinHeight="80">
     <Grid x:Name="PreviewHost" Background="Transparent" PointerPressed="Crop_Pressed" PointerMoved="Crop_Moved" PointerReleased="Crop_Released" PointerCanceled="Crop_Canceled">
      <Image x:Name="MainImage" Stretch="Uniform"/><TextBlock x:Name="EmptyPreview" Text="拖入一组照片，或批量导入文件夹" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
      <Canvas x:Name="CropCanvas" IsHitTestVisible="False"><Rectangle x:Name="CropOutline" Stroke="{ThemeResource AccentFillColorDefaultBrush}" StrokeThickness="2" Fill="#202080B0" Visibility="Collapsed"/></Canvas>
     </Grid>
    </Border>
    <CommandBar x:Name="AnalysisBar" Grid.Row="2" DefaultLabelPosition="Right" ClosedDisplayMode="Compact" Background="Transparent">
     <AppBarToggleButton x:Name="CropToggle" Icon="Crop" Label="框选目标" Click="CropToggle_Click"/>
   <AppBarButton Icon="Find" Label="联网识别" Click="Recognize_Click" IsEnabled="{x:Bind VM.SelectedEditable,Mode=OneWay}"/>
   <AppBarButton Icon="Refresh" Label="深入查证" Click="Deep_Click" IsEnabled="{x:Bind VM.SelectedEditable,Mode=OneWay}"/>
   <AppBarButton Icon="Cancel" Label="取消本组" Click="Cancel_Click" IsEnabled="{x:Bind VM.SelectedWorking,Mode=OneWay}"/>
     <AppBarButton Icon="Clear" Label="清除框选" Click="ClearCrop_Click"/>
     <AppBarButton Icon="Pictures" Label="查看原图" Click="OpenPhoto_Click"/>
      </CommandBar>
    <ListView x:Name="PhotoList" Grid.Row="3" ContextRequested="Photo_ContextRequested" SelectionMode="Extended" SelectionChanged="Photo_Changed" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollMode="Enabled" ScrollViewer.VerticalScrollMode="Disabled">
     <ListView.Resources><SolidColorBrush x:Key="ListViewItemSelectionIndicatorBrush" Color="Transparent"/><SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="{ThemeResource SystemAccentColor}" Opacity="0.20"/><SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="{ThemeResource SystemAccentColor}" Opacity="0.28"/><SolidColorBrush x:Key="ListViewItemBackgroundSelectedUnfocused" Color="{ThemeResource SystemAccentColor}" Opacity="0.18"/></ListView.Resources>
     <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="Padding" Value="2"/><Setter Property="Margin" Value="0,0,2,0"/><Setter Property="MinWidth" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListView.ItemContainerStyle>
     <ListView.ContextFlyout><MenuFlyout><MenuFlyoutItem x:Name="SplitPhotosMenu" Text="拆出选中照片" Click="Split_Click"/><MenuFlyoutItem x:Name="CopyPhotosMenu" Text="复制选中照片为新分组" Click="CopyPhotos_Click"/><MenuFlyoutItem x:Name="ExcludePhotosMenu" Text="排除／恢复选中照片" Click="Exclude_Click"/><MenuFlyoutSeparator/><MenuFlyoutItem x:Name="RemovePhotosMenu" Text="从本组删除选中照片（保留源照片）" Click="RemovePhotos_Click"/></MenuFlyout></ListView.ContextFlyout>
     <ListView.ItemsPanel><ItemsPanelTemplate><ItemsStackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListView.ItemsPanel>
     <ListView.ItemTemplate><DataTemplate x:DataType="core:Photo"><StackPanel Width="108" Spacing="2" Opacity="{x:Bind ThumbnailOpacity,Mode=OneWay}"><Image Source="{Binding ThumbnailUri,Converter={StaticResource SafeImageSourceConverter}}" Height="120" Stretch="Uniform" Loaded="Thumbnail_Loaded" ImageOpened="Thumbnail_Opened"/><TextBlock Text="{x:Bind Caption,Mode=OneWay}" FontSize="10" TextTrimming="CharacterEllipsis"/></StackPanel></DataTemplate></ListView.ItemTemplate>
    </ListView>

   </Grid>
   <Grid x:Name="EditorPane" Grid.Column="2" RowSpacing="8">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <InfoBar x:Name="VerificationBanner" Grid.Row="0" IsOpen="True" IsClosable="False"/>
    <ScrollViewer x:Name="EditorScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="10,0,10,0">
     <StackPanel Spacing="8">
      <TextBlock x:Name="VerificationText" Text="尚未识别 · 可手动填写" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
      <ContentControl IsEnabled="{x:Bind VM.SelectedEditable,Mode=OneWay}" HorizontalContentAlignment="Stretch">
       <StackPanel Spacing="8">
        <Grid ColumnSpacing="8" RowSpacing="6"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
         <TextBox x:Name="BrandEdit" Header="品牌" TextChanged="Editor_Changed"/><TextBox x:Name="SeriesEdit" Grid.Column="1" Header="车系" TextChanged="Editor_Changed"/>
         <TextBox x:Name="VariantEdit" Grid.Row="1" Header="完整型号" TextChanged="Editor_Changed"/><TextBox x:Name="BodyEdit" Grid.Row="1" Grid.Column="1" Header="车身形式（仅展示）" TextChanged="Editor_Changed"/>
         <TextBox x:Name="GenerationEdit" Grid.Row="2" Header="第几代" TextChanged="Editor_Changed"/><TextBox x:Name="CodeEdit" Grid.Row="2" Grid.Column="1" Header="代号" TextChanged="Editor_Changed"/>
         <TextBox x:Name="PhaseEdit" Grid.Row="3" Header="改款阶段" TextChanged="Editor_Changed"/><TextBox x:Name="PackageEdit" Grid.Row="3" Grid.Column="1" Header="套件 / 特别版本" TextChanged="Editor_Changed"/>
         <TextBox x:Name="OfficialNameEdit" Grid.Row="4" Grid.ColumnSpan="2" Header="官方完整营销名称（车身形式依据）" TextChanged="Editor_Changed"/>
         <TextBox x:Name="YearsEdit" Grid.Row="5" Grid.ColumnSpan="2" Header="该代生产年份范围（老车型命名依据）" PlaceholderText="YYYY-YYYY；未知留空" TextChanged="Editor_Changed"/>
        </Grid>
        <StackPanel Orientation="Horizontal" Spacing="6"><Button Content="重新生成名称" Click="Generate_Click"/><Button Content="撤回名称" Click="RestoreName_Click"/></StackPanel>
       </StackPanel>
      </ContentControl>
      <Expander x:Name="ApiResultExpander" Header="API 返回内容" HorizontalAlignment="Stretch">
       <StackPanel Spacing="8">
        <TextBlock x:Name="VerificationDetails" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
        <ItemsControl x:Name="VerificationSources"><ItemsControl.ItemTemplate><DataTemplate x:DataType="core:Citation"><HyperlinkButton Content="{x:Bind Title}" NavigateUri="{x:Bind Url}" HorizontalAlignment="Left" Padding="0"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
        <Button x:Name="AdoptVerificationButton" Content="采用修正" Click="AdoptVerification_Click"/>
       </StackPanel>
      </Expander>
      <Expander Header="照片证据与不确定项" HorizontalAlignment="Stretch"><StackPanel Spacing="6"><TextBlock x:Name="ObservationsText" TextWrapping="Wrap" IsTextSelectionEnabled="True"/><TextBlock x:Name="UncertaintyText" TextWrapping="Wrap" IsTextSelectionEnabled="True"/></StackPanel></Expander>
      <Expander Header="联网来源与用量" HorizontalAlignment="Stretch">
       <StackPanel Spacing="6"><TextBlock x:Name="ResearchText" TextWrapping="Wrap" IsTextSelectionEnabled="True"/><TextBlock x:Name="QueriesText" FontSize="11" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
        <ItemsControl x:Name="SourceList"><ItemsControl.ItemTemplate><DataTemplate x:DataType="core:Citation"><StackPanel Margin="0,0,0,6"><HyperlinkButton Content="{x:Bind Title}" NavigateUri="{x:Bind Url}" Padding="0" HorizontalAlignment="Left"/><TextBlock Text="{x:Bind Claim}" TextWrapping="Wrap" FontSize="11" IsTextSelectionEnabled="True"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
        <TextBlock x:Name="UsageText" FontSize="11" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
        <Expander x:Name="SearchWidgetExpander" Header="Google 搜索建议" HorizontalAlignment="Stretch" Visibility="Collapsed"><WebView2 x:Name="SearchWidget" Height="150"/></Expander>
       </StackPanel>
      </Expander>
     </StackPanel>
    </ScrollViewer>
    <Border x:Name="ArchiveFooter" Grid.Row="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" Padding="10" CornerRadius="6">
     <ContentControl IsEnabled="{x:Bind VM.SelectedEditable,Mode=OneWay}" HorizontalContentAlignment="Stretch">
      <Grid RowSpacing="5">
       <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <ScrollViewer x:Name="ArchiveOptionsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="5">
       <AutoSuggestBox x:Name="FolderEdit" Header="车型文件夹名称" PlaceholderText="点击或输入名称，模糊匹配现有分类" TextMemberPath="FolderName" UpdateTextOnSelect="False" MaxSuggestionListHeight="150" TextChanged="Folder_Changed" QuerySubmitted="Folder_QuerySubmitted">
        <AutoSuggestBox.ItemTemplate><DataTemplate x:DataType="core:CategorySuggestion"><TextBlock Padding="0,5" TextWrapping="Wrap"><Run Text="{x:Bind FolderName}"/><Run Text="{x:Bind BrandLabel}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></TextBlock></DataTemplate></AutoSuggestBox.ItemTemplate>
       </AutoSuggestBox>
       <Grid ColumnSpacing="6"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><AutoSuggestBox x:Name="TargetBrandEdit" Header="品牌目录" TextMemberPath="BrandDirectory" UpdateTextOnSelect="False" MaxSuggestionListHeight="240" TextChanged="Brand_Changed" QuerySubmitted="Brand_QuerySubmitted" LostFocus="TargetBrand_LostFocus"><AutoSuggestBox.ItemTemplate><DataTemplate x:DataType="core:CategorySuggestion"><TextBlock Text="{x:Bind BrandDirectory}" Padding="0,5"/></DataTemplate></AutoSuggestBox.ItemTemplate></AutoSuggestBox><ComboBox x:Name="ExistingBox" Grid.Column="1" Header="已有车型目录" HorizontalAlignment="Stretch" SelectionChanged="Existing_Changed"/></Grid>
       <Grid ColumnSpacing="6"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="RootText" Text="请选择归档根目录" FontSize="10" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTipService.ToolTip="{x:Bind VM.State.Settings.ArchiveRoot,Mode=OneWay}"/><Button Grid.Column="1" Content="目录…" Click="ChooseRoot_Click"/></Grid>
       <TextBlock x:Name="RuleText" FontSize="10" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
       <TextBlock x:Name="TargetPathText" FontSize="10" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </StackPanel>
       </ScrollViewer>
       <Grid Grid.Row="1" ColumnSpacing="6"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions><Button Content="记住名称" Click="Learn_Click"/><Button Grid.Column="1" Content="确认并移动" Click="Archive_Click" Style="{ThemeResource AccentButtonStyle}" HorizontalAlignment="Stretch" ToolTipService.ToolTip="Ctrl + Enter"/></Grid>
      </Grid>
     </ContentControl>
    </Border>
   </Grid>
  </Grid>
 </Grid>
</Page>
