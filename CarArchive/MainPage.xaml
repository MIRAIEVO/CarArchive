<Page x:Class="CarArchive.MainPage"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:core="using:CarArchive.Core"
 xmlns:local="using:CarArchive"
 AllowDrop="True" DragOver="Page_DragOver" Drop="Page_Drop" Loaded="Page_Loaded">
 <Page.Resources>
  <ResourceDictionary>
   <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light"><SolidColorBrush x:Key="PreviewSolidBrush" Color="#F8FAFC"/><SolidColorBrush x:Key="ReversalBackgroundBrush" Color="#F3B1BB"/><SolidColorBrush x:Key="ReversalHoverBrush" Color="#F8CCD3"/><SolidColorBrush x:Key="ReversalPressedBrush" Color="#EA99A7"/><SolidColorBrush x:Key="ReversalBorderBrush" Color="#B42E44"/></ResourceDictionary>
    <ResourceDictionary x:Key="Dark"><SolidColorBrush x:Key="PreviewSolidBrush" Color="#20262D"/><SolidColorBrush x:Key="ReversalBackgroundBrush" Color="#8B3346"/><SolidColorBrush x:Key="ReversalHoverBrush" Color="#A34C5D"/><SolidColorBrush x:Key="ReversalPressedBrush" Color="#72263A"/><SolidColorBrush x:Key="ReversalBorderBrush" Color="#F28B98"/></ResourceDictionary>
    <ResourceDictionary x:Key="HighContrast"><SolidColorBrush x:Key="PreviewSolidBrush" Color="{ThemeResource SystemColorWindowColor}"/><SolidColorBrush x:Key="ReversalBackgroundBrush" Color="{ThemeResource SystemColorButtonFaceColor}"/><SolidColorBrush x:Key="ReversalHoverBrush" Color="{ThemeResource SystemColorHighlightColor}"/><SolidColorBrush x:Key="ReversalPressedBrush" Color="{ThemeResource SystemColorButtonFaceColor}"/><SolidColorBrush x:Key="ReversalBorderBrush" Color="{ThemeResource SystemColorButtonTextColor}"/></ResourceDictionary>
   </ResourceDictionary.ThemeDictionaries>
   <Style x:Key="MoveActionStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}"><Setter Property="local:UiMotion.PressFeedback" Value="True"/></Style>
   <Style x:Key="UndoMoveActionStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}"><Setter Property="local:UiMotion.PressFeedback" Value="True"/>
    <Setter Property="Background" Value="{ThemeResource ReversalBackgroundBrush}"/>
    <Setter Property="BorderBrush" Value="{ThemeResource ReversalBorderBrush}"/>
   </Style>
   <Style x:Key="RecognizeActionStyle" TargetType="AppBarButton" BasedOn="{StaticResource DefaultAppBarButtonStyle}"><Setter Property="local:UiMotion.PressFeedback" Value="True"/><Setter Property="CornerRadius" Value="8"/></Style>
   <Style x:Key="CancelRecognitionActionStyle" TargetType="AppBarButton" BasedOn="{StaticResource RecognizeActionStyle}"><Setter Property="Background" Value="{ThemeResource ReversalBackgroundBrush}"/></Style>
   <Style x:Key="QuietButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}"><Setter Property="local:UiMotion.PressFeedback" Value="True"/>
    <Setter Property="BorderThickness" Value="0"/><Setter Property="Background" Value="Transparent"/>
    <Setter Property="Padding" Value="10,6"/>
   </Style>
  </ResourceDictionary>
 </Page.Resources>
 <Grid Padding="12,0,12,10" RowSpacing="6">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Grid x:Name="TopBar" Height="40" ColumnSpacing="8">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
    <DropDownButton x:Name="ModeButton" Height="36" BorderThickness="0" Background="Transparent" ToolTipService.ToolTip="选择AI识别强度">
     <TextBlock x:Name="ModeLabel" Text="Minimal"/>
     <DropDownButton.Flyout><Flyout x:Name="ModeFlyout" Opening="ModeFlyout_Opening"><StackPanel Width="320" Spacing="8">
      <TextBlock x:Name="ModePopupTitle" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center"/>
      <TextBlock x:Name="ModeModelText" FontSize="12" HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
      <Slider x:Name="ModeSlider" Minimum="0" Maximum="6" StepFrequency="1" TickFrequency="1" TickPlacement="BottomRight" SnapsTo="StepValues" IsThumbToolTipEnabled="False" ValueChanged="ModeSlider_Changed" AutomationProperties.Name="AI识别强度"/>
      <ToggleSwitch x:Name="ModeSearchToggle" Header="联网搜索" OffContent="关闭" OnContent="开启" Toggled="ModeSearch_Changed"/>
      <TextBlock x:Name="ModeDescription" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
      <Button x:Name="ApplySelectedMode" Content="将当前档位和联网设置应用到所选组" Click="ApplySelectedMode_Click" Visibility="Collapsed"/>
      <HyperlinkButton Content="厂商与模型设置" Click="ModeSettings_Click" HorizontalAlignment="Center"/>
     </StackPanel></Flyout></DropDownButton.Flyout>
    </DropDownButton>
    <ToggleSwitch x:Name="UploadMultipleToggle" MinWidth="44" OffContent="单图" OnContent="多图" Toggled="UploadMultiple_Changed" AutomationProperties.Name="多张上传" ToolTipService.ToolTip="多张上传：上传本组全部框选；无框选时上传当前预览。关闭时仅上传当前预览或其框选。所有分组共用并自动记忆。"/>
    <ComboBox x:Name="PaneBox" Width="80" SelectedIndex="1" Visibility="Collapsed" SelectionChanged="Pane_Changed"><ComboBoxItem Content="分组"/><ComboBoxItem Content="照片"/><ComboBoxItem Content="复核"/></ComboBox>
   </StackPanel>
   <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
    <Button x:Name="ImportGroupButton" Height="36" MinHeight="0" Style="{StaticResource QuietButtonStyle}" Click="ImportGroup_Click"><StackPanel Orientation="Horizontal" Spacing="6"><SymbolIcon Symbol="Add"/><TextBlock x:Name="ImportGroupLabel" Text="导入一组" FontSize="12"/></StackPanel></Button>
    <Button x:Name="BatchImportButton" Height="36" MinHeight="0" Style="{StaticResource QuietButtonStyle}" Click="ImportBatch_Click"><StackPanel Orientation="Horizontal" Spacing="6"><SymbolIcon Symbol="OpenFile"/><TextBlock x:Name="BatchImportLabel" Text="批量导入" FontSize="12"/></StackPanel></Button>
    <Button x:Name="MoreButton" Height="36" MinHeight="0" Padding="0" Width="36" Style="{StaticResource QuietButtonStyle}" ToolTipService.ToolTip="更多命令">
     <SymbolIcon Symbol="More"/>
     <Button.Flyout><MenuFlyout>
      <MenuFlyoutItem Icon="Setting" Text="设置" Click="Settings_Click"/>
      <MenuFlyoutItem Icon="Edit" Text="命名学习" Click="Rules_Click"/>
      <MenuFlyoutItem Icon="Clock" Text="操作记录与恢复" Click="History_Click"/>
      <MenuFlyoutItem Icon="Undo" Text="撤回最近操作" Click="Undo_Click"/>
     </MenuFlyout></Button.Flyout>
    </Button>
   </StackPanel>
  </Grid>
  <Grid Grid.Row="1" ColumnSpacing="8">
   <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <TextBlock Text="{x:Bind VM.Summary,Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
   <TextBlock Grid.Column="1" Text="{x:Bind VM.Status,Mode=OneWay}" FontSize="11" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
   <InfoBar x:Name="Notice" IsOpen="False" Visibility="Collapsed"/>
  </Grid>
  <Grid x:Name="BodyGrid" Grid.Row="2" ColumnSpacing="12" SizeChanged="Body_SizeChanged">
   <Grid.ColumnDefinitions><ColumnDefinition x:Name="QueueColumn" Width="210"/><ColumnDefinition Width="*"/><ColumnDefinition x:Name="EditorColumn" Width="350"/></Grid.ColumnDefinitions>
   <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition x:Name="NarrowRow" Height="0"/></Grid.RowDefinitions>
   <Grid x:Name="QueuePane" RowSpacing="6">
    <Grid.RowDefinitions><RowDefinition Height="*"/></Grid.RowDefinitions>
    <ListView x:Name="GroupList" ContextRequested="Group_ContextRequested" ItemsSource="{x:Bind VM.Groups}" SelectionMode="Extended" SelectionChanged="Group_Changed" Padding="0">
     <ListView.ItemContainerTransitions><TransitionCollection/></ListView.ItemContainerTransitions>
     <ListView.Resources><SolidColorBrush x:Key="ListViewItemSelectionIndicatorBrush" Color="Transparent"/><SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="{ThemeResource SystemAccentColor}" Opacity="0.20"/><SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="{ThemeResource SystemAccentColor}" Opacity="0.28"/><SolidColorBrush x:Key="ListViewItemBackgroundSelectedUnfocused" Color="{ThemeResource SystemAccentColor}" Opacity="0.18"/></ListView.Resources>
     <ListView.ContextFlyout><MenuFlyout><MenuFlyoutItem x:Name="MergeGroupsMenu" Text="合并选中分组"><MenuFlyoutItem.Icon><PathIcon Data="M3,3 H9 V8 H15 V3 H21 V11 H15 V16 H9 V11 H3 Z M9,18 H15 V22 H9 Z"/></MenuFlyoutItem.Icon></MenuFlyoutItem><MenuFlyoutItem x:Name="DuplicateGroupMenu" Text="复制分组"><MenuFlyoutItem.Icon><PathIcon Data="M8,2 H22 V17 H18 V6 H8 Z M2,8 H16 V22 H2 Z M4,10 V20 H14 V10 Z"/></MenuFlyoutItem.Icon></MenuFlyoutItem><MenuFlyoutSeparator/><MenuFlyoutItem Text="撤回本组操作"><MenuFlyoutItem.Icon><PathIcon Data="M9,3 V7 H14 C24,7 24,21 14,21 H9 V18 H14 C20,18 20,10 14,10 H9 V14 L2,8 Z"/></MenuFlyoutItem.Icon></MenuFlyoutItem><MenuFlyoutItem Text="重做本组操作"><MenuFlyoutItem.Icon><PathIcon Data="M15,3 V7 H10 C0,7 0,21 10,21 H15 V18 H10 C4,18 4,10 10,10 H15 V14 L22,8 Z"/></MenuFlyoutItem.Icon></MenuFlyoutItem><MenuFlyoutSeparator/><MenuFlyoutItem x:Name="DeleteGroupsMenu" Text="删除分组"><MenuFlyoutItem.Icon><PathIcon Data="M3,11 H21 V14 H3 Z"/></MenuFlyoutItem.Icon></MenuFlyoutItem><MenuFlyoutItem x:Name="RecycleGroupsMenu" Text="删除分组及文件"><MenuFlyoutItem.Icon><PathIcon Data="M7,2 H17 V5 H22 V7 H2 V5 H7 Z M5,9 H19 L18,22 H6 Z M9,11 V19 H11 V11 Z M13,11 V19 H15 V11 Z"/></MenuFlyoutItem.Icon></MenuFlyoutItem><MenuFlyoutItem x:Name="DeleteArchivedMenu" Text="清理已归档记录（保留文件）"><MenuFlyoutItem.Icon><PathIcon Data="M2,3 H22 V8 H2 Z M4,10 H20 V22 H4 Z M9,12 V15 H15 V12 Z"/></MenuFlyoutItem.Icon></MenuFlyoutItem></MenuFlyout></ListView.ContextFlyout>
     <ListView.ItemTemplate><DataTemplate x:DataType="core:PhotoGroup">
      <Grid Padding="0,5" ColumnSpacing="7" Opacity="{x:Bind DisplayOpacity,Mode=OneWay}">
       <Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/></Grid.ColumnDefinitions>
       <Image Source="{Binding CoverUri,Converter={StaticResource SafeImageSourceConverter}}" Width="48" Height="48" Stretch="UniformToFill"/>
       <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center"><Grid><TextBlock Text="{x:Bind Title,Mode=OneWay}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" FontSize="12"/><Border Height="1" VerticalAlignment="Center" Background="{ThemeResource TextFillColorPrimaryBrush}" Opacity="{x:Bind ArchivedStrikeOpacity,Mode=OneWay}"/></Grid><TextBlock Text="{x:Bind Subtitle,Mode=OneWay}" FontSize="10" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind TaskLabel,Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel>
       <Ellipse Grid.Column="2" Width="8" Height="8" Fill="{Binding TaskColor}" ToolTipService.ToolTip="{x:Bind TaskLabel,Mode=OneWay}"/>
      </Grid>
     </DataTemplate></ListView.ItemTemplate>
    </ListView>
    <Button x:Name="MergeSelectionButton" Content="合并" Click="Merge_Click" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,0,12,0" Width="50" Height="30" MinHeight="0" Padding="5,0" CornerRadius="12" Style="{StaticResource AccentButtonStyle}"/>
   </Grid>
   <Grid x:Name="PreviewPane" Grid.Column="1" RowSpacing="6">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition x:Name="ThumbnailRow" Height="146"/></Grid.RowDefinitions>
    <TextBlock x:Name="PhotoCaption" Text="点击缩略图即设为代表图" FontSize="12" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
    <Border x:Name="PreviewSurface" Grid.Row="1" Background="{ThemeResource PreviewSolidBrush}" CornerRadius="10" MinHeight="80">
     <ScrollViewer x:Name="PreviewZoom" SizeChanged="PreviewZoom_SizeChanged" ZoomMode="Enabled" MinZoomFactor="1" MaxZoomFactor="8" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" ViewChanged="PreviewZoom_Changed"><Grid x:Name="PreviewHost" Background="Transparent" PointerWheelChanged="Preview_WheelChanged" PointerPressed="Crop_Pressed" PointerMoved="Crop_Moved" PointerReleased="Crop_Released" PointerCanceled="Crop_Canceled">
      <MediaPlayerElement x:Name="VideoPlayer" Visibility="Collapsed" AreTransportControlsEnabled="True"/><Image x:Name="MainImage" Stretch="Uniform"/><TextBlock x:Name="EmptyPreview" Text="拖入一组照片，或批量导入文件夹" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
      <Canvas x:Name="CropCanvas" IsHitTestVisible="False"><Rectangle x:Name="CropOutline" Stroke="{ThemeResource AccentFillColorDefaultBrush}" StrokeThickness="2" Fill="#202080B0" Visibility="Collapsed"/></Canvas>
     </Grid>
    </ScrollViewer></Border>
    <Canvas x:Name="PreviewTransitionCover" Grid.Row="1" Background="{ThemeResource PreviewSolidBrush}" IsHitTestVisible="False" Visibility="Collapsed"/>
    <CommandBar x:Name="AnalysisBar" Grid.Row="2" Height="56" Padding="0,4" HorizontalAlignment="Center" DefaultLabelPosition="Right" ClosedDisplayMode="Compact" Background="Transparent">
     <CommandBar.Resources><Style TargetType="AppBarButton" BasedOn="{StaticResource RecognizeActionStyle}"/><Style TargetType="AppBarToggleButton" BasedOn="{StaticResource DefaultAppBarToggleButtonStyle}"><Setter Property="CornerRadius" Value="8"/></Style></CommandBar.Resources>
     <AppBarToggleButton x:Name="CropToggle" Icon="Crop" Label="框选目标" Click="CropToggle_Click"/>
   <local:RecognitionButton x:Name="RecognizeActionButton" Label="AI识别" Icon="Find" Click="Recognize_Click" Style="{StaticResource RecognizeActionStyle}" IsEnabled="{x:Bind VM.SelectedCanRecognize,Mode=OneWay}"/>
   <AppBarButton Icon="Copy" Label="复制框选图片" Click="Deep_Click"/>
   <AppBarButton Icon="Copy" Label="复制验证提示词" Click="CopyVerificationPrompt_Click"/>
     <AppBarButton Icon="Clear" Label="清除框选" Click="ClearCrop_Click"/>
     <AppBarButton Icon="Pictures" Label="查看原图" Click="OpenPhoto_Click"/>
      </CommandBar>
    <Border x:Name="ThumbnailSurface" Grid.Row="3" Background="{ThemeResource PreviewSolidBrush}" CornerRadius="10"><ListView x:Name="PhotoList" ContextRequested="Photo_ContextRequested" SelectionMode="Extended" SelectionChanged="Photo_Changed" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollMode="Enabled" ScrollViewer.VerticalScrollMode="Disabled">
     <ListView.ItemContainerTransitions><TransitionCollection/></ListView.ItemContainerTransitions>
     <ListView.Resources><SolidColorBrush x:Key="ListViewItemSelectionIndicatorBrush" Color="Transparent"/><SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="Transparent"/><SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="Transparent"/><SolidColorBrush x:Key="ListViewItemBackgroundSelectedUnfocused" Color="Transparent"/><SolidColorBrush x:Key="ThumbnailCaptionSelectionBrush" Color="{ThemeResource SystemAccentColor}" Opacity="0.20"/></ListView.Resources>
     <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,2,0"/><Setter Property="MinWidth" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="VerticalContentAlignment" Value="Top"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListViewItem"><Grid Background="Transparent" Control.IsTemplateFocusTarget="True"><ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" HorizontalAlignment="Left" VerticalAlignment="Top"/></Grid></ControlTemplate></Setter.Value></Setter></Style></ListView.ItemContainerStyle>
     <ListView.ContextFlyout><MenuFlyout><MenuFlyoutItem x:Name="SplitPhotosMenu" Text="拆出为新分组"><MenuFlyoutItem.Icon><PathIcon Data="M10,2 H14 V10 L22,18 L19,21 L12,14 L5,21 L2,18 L10,10 Z"/></MenuFlyoutItem.Icon></MenuFlyoutItem><MenuFlyoutItem x:Name="CopyPhotosMenu" Text="复制为新分组"><MenuFlyoutItem.Icon><PathIcon Data="M8,2 H22 V17 H18 V6 H8 Z M2,8 H16 V22 H2 Z M4,10 V20 H14 V10 Z"/></MenuFlyoutItem.Icon></MenuFlyoutItem><MenuFlyoutSeparator/><MenuFlyoutItem Text="撤回本组操作"><MenuFlyoutItem.Icon><PathIcon Data="M9,3 V7 H14 C24,7 24,21 14,21 H9 V18 H14 C20,18 20,10 14,10 H9 V14 L2,8 Z"/></MenuFlyoutItem.Icon></MenuFlyoutItem><MenuFlyoutItem Text="重做本组操作"><MenuFlyoutItem.Icon><PathIcon Data="M15,3 V7 H10 C0,7 0,21 10,21 H15 V18 H10 C4,18 4,10 10,10 H15 V14 L22,8 Z"/></MenuFlyoutItem.Icon></MenuFlyoutItem><MenuFlyoutSeparator/><MenuFlyoutItem x:Name="RemovePhotosMenu" Text="删除照片"><MenuFlyoutItem.Icon><PathIcon Data="M3,11 H21 V14 H3 Z"/></MenuFlyoutItem.Icon></MenuFlyoutItem><MenuFlyoutItem x:Name="RecyclePhotosMenu" Text="删除照片及文件"><MenuFlyoutItem.Icon><PathIcon Data="M7,2 H17 V5 H22 V7 H2 V5 H7 Z M5,9 H19 L18,22 H6 Z M9,11 V19 H11 V11 Z M13,11 V19 H15 V11 Z"/></MenuFlyoutItem.Icon></MenuFlyoutItem></MenuFlyout></ListView.ContextFlyout>
     <ListView.ItemsPanel><ItemsPanelTemplate><ItemsStackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListView.ItemsPanel>
     <ListView.ItemTemplate><DataTemplate x:DataType="core:Photo"><StackPanel MinWidth="1" Spacing="2" Opacity="{x:Bind ThumbnailOpacity,Mode=OneWay}"><Image Source="{Binding ThumbnailUri,Converter={StaticResource SafeImageSourceConverter}}" Height="120" Stretch="Uniform" Loaded="Thumbnail_Loaded" ImageOpened="Thumbnail_Opened"/><Border Background="Transparent" HorizontalAlignment="Stretch" Padding="0,4" Loaded="ThumbnailCaption_Loaded"><TextBlock Text="{x:Bind Caption,Mode=OneWay}" FontSize="10" TextTrimming="CharacterEllipsis"/></Border></StackPanel></DataTemplate></ListView.ItemTemplate>
    </ListView></Border>
    <Canvas x:Name="ThumbnailTransitionCover" Grid.Row="3" Background="{ThemeResource PreviewSolidBrush}" IsHitTestVisible="False" Visibility="Collapsed"/>

   </Grid>
   <Grid x:Name="EditorPane" Grid.Column="2" RowSpacing="8">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <InfoBar x:Name="VerificationBanner" Grid.Row="0" IsOpen="True" IsClosable="False"/>
    <ScrollViewer x:Name="EditorScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="10,0,10,0">
     <StackPanel Spacing="8">
      <Grid ColumnSpacing="6"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="VerificationText" Text="尚未识别 · 可手动填写" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/><Button x:Name="PasteIdentityButton" Grid.Column="1" Content="粘贴 JSON" Click="PasteIdentity_Click" IsEnabled="{x:Bind VM.SelectedEditable,Mode=OneWay}"/></Grid>
      <ContentControl IsEnabled="{x:Bind VM.SelectedEditable,Mode=OneWay}" HorizontalContentAlignment="Stretch">
       <StackPanel Spacing="8">
        <Grid ColumnSpacing="8" RowSpacing="6"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
         <TextBox x:Name="BrandEdit" Header="品牌" TextChanged="Editor_Changed"/><TextBox x:Name="SeriesEdit" Grid.Column="1" Header="车系" TextChanged="Editor_Changed"/>
         <TextBox x:Name="VariantEdit" Grid.Row="1" Header="完整型号" TextChanged="Editor_Changed"/><TextBox x:Name="BodyEdit" Grid.Row="1" Grid.Column="1" Header="车身形式（仅展示）" TextChanged="Editor_Changed"/>
         <TextBox x:Name="GenerationEdit" Grid.Row="2" Header="第几代" TextChanged="Editor_Changed"/><TextBox x:Name="CodeEdit" Grid.Row="2" Grid.Column="1" Header="代号" TextChanged="Editor_Changed"/>
         <TextBox x:Name="PhaseEdit" Grid.Row="3" Header="改款阶段" TextChanged="Editor_Changed"/><TextBox x:Name="PackageEdit" Grid.Row="3" Grid.Column="1" Header="套件 / 特别版本" TextChanged="Editor_Changed"/>
         <TextBox x:Name="OfficialNameEdit" Grid.Row="4" Grid.ColumnSpan="2" Header="官方完整营销名称（车身形式依据）" TextChanged="Editor_Changed"/>
         <TextBox x:Name="YearsEdit" Grid.Row="5" Grid.ColumnSpan="2" Header="该代生产年份范围（老车型命名依据）" PlaceholderText="YYYY-YYYY；未知留空" TextChanged="Editor_Changed"/>
        </Grid>
        <StackPanel Orientation="Horizontal" Spacing="6"><Button Content="重新生成名称" Click="Generate_Click"/><Button x:Name="RestoreFolderNameButton" Content="撤回名称" Click="RestoreName_Click"/></StackPanel>
       </StackPanel>
      </ContentControl>
      <Expander x:Name="ApiResultExpander" Header="API 返回内容" HorizontalAlignment="Stretch">
       <StackPanel Spacing="8">
        <TextBlock x:Name="VerificationDetails" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
        <ItemsControl x:Name="VerificationSources"><ItemsControl.ItemTemplate><DataTemplate x:DataType="core:Citation"><HyperlinkButton Content="{x:Bind Title}" NavigateUri="{x:Bind Url}" HorizontalAlignment="Left" Padding="0"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
        <Button x:Name="AdoptVerificationButton" Content="采用修正" Click="AdoptVerification_Click"/>
       </StackPanel>
      </Expander>
      <Expander Header="照片证据与不确定项" HorizontalAlignment="Stretch"><StackPanel Spacing="6"><TextBlock x:Name="ObservationsText" TextWrapping="Wrap" IsTextSelectionEnabled="True"/><TextBlock x:Name="UncertaintyText" TextWrapping="Wrap" IsTextSelectionEnabled="True"/></StackPanel></Expander>
      <Expander Header="联网来源与用量" HorizontalAlignment="Stretch">
       <StackPanel Spacing="6"><TextBlock x:Name="ResearchText" TextWrapping="Wrap" IsTextSelectionEnabled="True"/><TextBlock x:Name="QueriesText" FontSize="11" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
        <ItemsControl x:Name="SourceList"><ItemsControl.ItemTemplate><DataTemplate x:DataType="core:Citation"><StackPanel Margin="0,0,0,6"><HyperlinkButton Content="{x:Bind Title}" NavigateUri="{x:Bind Url}" Padding="0" HorizontalAlignment="Left"/><TextBlock Text="{x:Bind Claim}" TextWrapping="Wrap" FontSize="11" IsTextSelectionEnabled="True"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
        <TextBlock x:Name="UsageText" FontSize="11" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
        <Expander x:Name="SearchWidgetExpander" Header="Google 搜索建议" HorizontalAlignment="Stretch" Visibility="Collapsed"><WebView2 x:Name="SearchWidget" Height="150"/></Expander>
       </StackPanel>
      </Expander>
     </StackPanel>
    </ScrollViewer>
    <Border x:Name="ArchiveFooter" Grid.Row="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" Padding="10" CornerRadius="10">
     <ContentControl HorizontalContentAlignment="Stretch">
      <Grid RowSpacing="5">
       <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <ScrollViewer IsEnabled="{x:Bind VM.SelectedEditable,Mode=OneWay}" x:Name="ArchiveOptionsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="5">
       <AutoSuggestBox x:Name="FolderEdit" Header="车型文件夹名称" PlaceholderText="点击或输入名称，模糊匹配现有分类" TextMemberPath="FolderName" UpdateTextOnSelect="False" MaxSuggestionListHeight="150" TextChanged="Folder_Changed" QuerySubmitted="Folder_QuerySubmitted">
        <AutoSuggestBox.ItemTemplate><DataTemplate x:DataType="core:CategorySuggestion"><TextBlock Padding="0,5" TextWrapping="Wrap"><Run Text="{x:Bind FolderName}"/><Run Text="{x:Bind BrandLabel}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></TextBlock></DataTemplate></AutoSuggestBox.ItemTemplate>
       </AutoSuggestBox>
       <Grid ColumnSpacing="6"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><AutoSuggestBox x:Name="TargetBrandEdit" Header="品牌目录" TextMemberPath="BrandDirectory" UpdateTextOnSelect="False" MaxSuggestionListHeight="240" TextChanged="Brand_Changed" QuerySubmitted="Brand_QuerySubmitted" LostFocus="TargetBrand_LostFocus"><AutoSuggestBox.ItemTemplate><DataTemplate x:DataType="core:CategorySuggestion"><TextBlock Text="{x:Bind BrandDirectory}" Padding="0,5"/></DataTemplate></AutoSuggestBox.ItemTemplate></AutoSuggestBox><ComboBox x:Name="ExistingBox" Grid.Column="1" Header="已有车型目录" HorizontalAlignment="Stretch" SelectionChanged="Existing_Changed"/></Grid>
       <Grid ColumnSpacing="6"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="RootText" Text="请选择归档根目录" FontSize="10" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTipService.ToolTip="{x:Bind VM.State.Settings.ArchiveRoot,Mode=OneWay}"/><Button Grid.Column="1" Content="目录…" Click="ChooseRoot_Click"/></Grid>
       <TextBlock x:Name="RuleText" FontSize="10" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
       <TextBlock x:Name="TargetPathText" FontSize="10" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </StackPanel>
       </ScrollViewer>
       <Grid Grid.Row="1" ColumnSpacing="6"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions><Button IsEnabled="{x:Bind VM.SelectedEditable,Mode=OneWay}" Content="记住名称" Click="Learn_Click"/><Button x:Name="ArchiveActionButton" IsEnabled="{x:Bind VM.SelectedCanArchiveAction,Mode=OneWay}" Grid.Column="1" Content="确认并移动" Click="Archive_Click" Style="{ThemeResource AccentButtonStyle}" HorizontalAlignment="Stretch" ToolTipService.ToolTip="Ctrl + Enter"/></Grid>
      </Grid>
     </ContentControl>
    </Border>
